<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Web</RootNamespace>
    <UserSecretsId>ComercialStock-Web-Portfolio</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="../Application/Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="RequireFrontend" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('wwwroot/dist/login.js')" Text="Compila el frontend antes de publicar: npm ci y npm run build en ComercialStockWeb." />
  </Target>
</Project>
