@model InventarioViewModel
@{ ViewData["Title"] = "Inventario"; var cl = CultureInfo.GetCultureInfo("es-CL"); }
<div class="page-heading"><div><p class="eyebrow">EXISTENCIAS POR BODEGA</p><h1>Inventario</h1><p class="muted">Disponible = existencia física − reservas vigentes.</p></div>@if(User.IsInRole("Administrador") || User.IsInRole("Bodeguero")){<a asp-action="Cargar" class="primary-button button-auto">Ingresar desde Excel</a>}</div>
<section class="panel"><form method="get" class="filter-bar"><label>Bodega<select name="bodega"><option value="">Todas</option>@foreach(var b in Model.Bodegas){<option value="@b.BodegaId" selected="@(Model.Bodega==b.BodegaId)">@b.Nombre</option>}</select></label><label>Producto<input name="buscar" value="@Model.Buscar" placeholder="SKU o nombre" maxlength="200" /></label><button class="secondary-button">Filtrar</button><a asp-action="Exportar" asp-route-bodega="@Model.Bodega" asp-route-buscar="@Model.Buscar">Exportar Excel</a></form>
<div class="table-scroll"><table class="data-table"><thead><tr><th>Bodega</th><th>SKU</th><th>Producto</th><th>Unidad</th><th>Físico</th><th>Reservado</th><th>Disponible</th></tr></thead><tbody>
@foreach(var s in Model.Filas){<tr><td>@s.Bodega</td><td>@s.SKU</td><td>@s.Producto</td><td>@s.UnidadMedida</td><td>@s.CantidadFisica.ToString("0.###",cl)</td><td>@s.Reservada.ToString("0.###",cl)</td><td><strong>@s.Disponible.ToString("0.###",cl)</strong></td></tr>}
</tbody></table></div>@if(Model.Filas.Count==0){<p class="empty-state">No hay productos o bodegas para este filtro. Crea una bodega y carga su inventario.</p>}</section>
