@{ ViewData["Title"] = "Operación no completada"; }
<section class="panel">
    <p class="eyebrow">REVISA LA OPERACIÓN</p><h1 class="text-2xl mt-3">No se pudo completar</h1>
    <div class="notice warning" role="alert">@ViewData["Mensaje"]</div>
